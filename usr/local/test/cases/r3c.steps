cd /tmp; od -cbdox /t/words >o; sed 4q o
echo hello world | crypt secret | od -b | sed 2q; echo hello | crypt k1 | crypt k1
echo abcdefghijkl | dd bs=1w count=1 2>/dev/null; echo
sp </t/words; sp 20 </t/long | wc
uniq -c /t/sortin; uniq -c /t/long | wc
file /t/asm /t/bcf /t/ctxt /t/long /t/roff /t/sortin /t/u2 /t/words /t/edscr
find /etc -user root -print | wc -l; find /t -size -2 -print; find /bin -name 'c?' -perm 755 -print
find /t -type f -links 1 -name 'w*' -exec echo found {} \; ; find /etc -group 0 -mtime -100000 -print | wc -l; find / -inum 2 -print
find /t ! -type d -ctime -100000 -atime -100000 -print | wc -l
ps ax | wc -l; ps; ps alx | wc -l
pstat -t >o; sed 's/\#/N/' o; pstat -p >o; sed 2q o; pstat -i >o; sed 2q o
pstat -f >o; sed 2q o; pstat -x >o; sed 2q o
dcheck /dev/root; dcheck -i 2 /dev/root; icheck -b 5 /dev/root
echo '2^40; scale=3; 1/3; 7%3' | bc
cp /t/words w; ed - w </t/edscr; cat w; cp /t/words w2; ed w2 </t/edscr; echo st$?; cat w2
expr 1 + 2; expr abc : 'a\(.\)'; expr 'a\b' : 'a\\b'; expr abc : 'a\('; echo st$?
echo hi | tee t1 t2; echo ho | tee -a t1 >/dev/null; cat t1 t2
look -f ban /t/words; echo hello | tr a-z A-Z; sort -u /t/sortin; sort -m /t/sortin /t/words | wc
sort -c /t/sortin; echo $?; sort -n +1 /t/sortin
ptx /t/words | sed 2q; ptx -i /dev/null /t/words
factor 360 1000000007 4294967297; echo x | tc | od -b | sed 2q; diff /t/words /t/sortin | wc; who
iostat | sed 2q; iostat | wc -l; prof /bin/ls; arcv /t/words
units </t/u2 | sed 3q
osh -c 'echo hi; echo $0 there'; echo 'echo $$ x; date >/dev/null' | osh >o 2>&1; sed 's/[0-9]/N/g; s/\#/P/g' o
dump 0f /tmp/d /dev/root 2>&1 | wc -l; dumpdir f /tmp/d | sed -n '1,3p;/words/p'; restor tf /tmp/d | sed 3q
mkdir rx; cd rx; echo 1 | restor xf /tmp/d t/words; ls; cmp * /t/words; echo cmp$?; cd /tmp; rm -r rx /tmp/d
echo 1+1 | bc /nonexist /t/bcf; echo bcst$?
echo 'zz:x:123\c' >>/etc/passwd; find /t -user zz -print; echo findst$?
