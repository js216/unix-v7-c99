T=/tmp/sig U=/usr/local/test/utils
mkdir $T; cd $T
(sleep 2; kill -2 `cat p`) &
sh -c 'echo $$ >p; exec sleep 100'; echo rc=$?; wait
(sleep 2; kill -2 `cat p`) &
sh -c 'echo $$ >p; exec yes' >/dev/null; echo rc=$?; wait
(sleep 2; kill -2 `cat p1`) &
sh -c 'echo $$ >p1; exec yes' | sh -c 'echo $$ >p2; exec cat' >/dev/null; echo rc=$?; wait
(sleep 2; kill -2 `cat p1` `cat p2`) &
sh -c 'echo $$ >p1; trap "echo caught; exit 3" 2; echo ready; sh -c "echo \$\$ >p2; exec sleep 100"'
echo rc=$?; wait
(sleep 2; kill `cat p`) &
sh -c 'echo $$ >p; exec sleep 100'; echo kd=$?; wait
(sleep 2; kill -9 `cat p`) &
sh -c 'echo $$ >p; exec yes' >/dev/null; echo k9=$?; wait
sh -c 'trap "echo term" 15; kill $$; echo after'
ls /bin | wc -l
cd /; rm -rf $T
