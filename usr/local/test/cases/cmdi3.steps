cd /tmp; osh -c 'echo a; echo b >x; cat x; ls x | wc -l'; osh -c 'false; echo c; echo d >>x; cat <x'
echo 'echo in osh script; echo $1 arg; nonexistcmd' >o.sh; echo '(echo sub; echo shell) | wc -l; chdir /etc; pwd; shift; echo $1' >>o.sh; osh o.sh one two
osh -c 'echo x* ; echo "q*"; sleep 1 & wait; echo waited'; osh -c 'chdir; shift; login' ; echo st$?
echo 'echo in osh script; date >/dev/null; echo $1 arg' >o2.sh; osh o2.sh one; osh -c 'echo hi; echo $0 there'
for i in 1 2 3 4 5; do echo crypttest | crypt key | crypt key; done; echo abcdefghij | /usr/lib/makekey | wc -c; echo crypttest | crypt key | od -c | sed 2q
echo one two three four five six seven | sp; echo hi there | tc -t | od -c | sed 4q
>/usr/adm/acct; /etc/accton /usr/adm/acct; ls /bin >/dev/null; date >/dev/null; ls >/dev/null; cat /etc/passwd >/dev/null; /etc/accton
for f in -a -b -c -j -l -m -n -r -t; do sa $f | sed 's/[0-9]*\.[0-9][0-9]*%*/T/g; s/  */ /g' | sort; done; sa -u | sed 3q
dcheck /dev/root; ncheck /dev/root | sed 6q; ncheck -i 1 /dev/root; ncheck -s /dev/root
echo 'tst::5:3::/tmp:' >>/etc/passwd; tail -1 /etc/passwd; cat /etc/group
@# |^D
@\x8dlo|tst\n
@$ |tty; mesg n; mesg; mesg y; mesg\n
@$ |who; who am i; ac; ac -p; ac -d; ac -w /usr/adm/wtmp tst\n
@$ |newgrp nosuch\n
@$ |newgrp sys\n
@$ |echo TEST""DONE\n
