T=/tmp/ddend U=/usr/local/test/utils
mkdir $T; cd $T
set `$U/swb`; e=`expr $2 - 1`
echo end of disk | dd of=/dev/rrk0 bs=512 seek=$e conv=sync
dd if=/dev/rrk0 bs=65536 skip=`expr $e / 128` count=1 2>/dev/null | dd bs=512 skip=`expr $e % 128` count=1 >o 2>e; cat e; od -c o
dd if=/dev/rrk0 bs=512 skip=99999999999 count=1; echo st$?
cd /; rm -rf $T
