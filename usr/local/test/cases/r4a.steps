ls -l /bin/su /bin/mkdir /bin/login /bin/mv /usr/lib/atrun /dev/mem | awk '{ print $1, $3, $NF }'; ls -l /usr/adm
rm /etc/mtab; rm /etc/mtab; echo rc$?
cd /tmp; echo ab >e; grep '\(ab\)\1*a' e; echo grep$?
ed - e
@|g/\(ab\)\1*a/p\n
@|q\n
set a b c; for i do for j do :; done; done; cd /nonexistent
echo args $*
echo after
ps l
echo '* * * * * /etc/dmesg - >>/usr/adm/messages' >/usr/lib/crontab; /etc/cron; sleep 75; ls -l /usr/adm; sed 3q /usr/adm/messages
date 3802010000; date; echo date$?
yes : | sed 100000q >l; echo fi >>l; sh l
