#!/usr/bin/env expect
# SPDX-License-Identifier: MIT
# fscheck.expect --- icheck / dcheck / ncheck on a v7 fs image
# Copyright (c) 2026 Jakob Kastelic
#
# /etc/auxfs is a small V7 filesystem image baked into the rootfs at
# build time (one regular file `/a`).  The V7 fs check programs run
# against it print headers like "files N (r=...,d=...,b=...,c=...)"
# which is what the mission verifier looks for.

set kernel   $env(KERNEL)
set root_img $env(ROOT_IMG)
set log_path $env(LOG)

log_user 0
log_file -a $log_path

set timeout 90

spawn -noecho qemu-system-arm \
	-machine virt -cpu cortex-a7 -nographic -no-reboot \
	-kernel $kernel \
	-drive if=none,file=$root_img,format=raw,id=hd0 \
	-device virtio-blk-device,drive=hd0

expect {
	timeout { exit 1 }
	"login:"
}
send "root\r"

expect {
	timeout { exit 1 }
	"# "
}
send "icheck /etc/auxfs\r"
expect "# "
send "echo ICHECKOK\r"
expect "# "
send "dcheck /etc/auxfs\r"
expect "# "
send "echo DCHECKOK\r"
expect "# "
send "ncheck /etc/auxfs\r"
expect "# "
send "echo NCHECKOK\r"
expect "# "
send "echo FSCHECKOK\r"
expect "# "
send "exit\r"
# Ctrl-A x: in -nographic mode, qemu interprets the stdio escape
# sequence Ctrl-A then x as a monitor "quit" command, terminating
# qemu immediately. Without this the wrapper would block in expect
# eof until the wall-clock timeout in qemu-shell.sh fires.
sleep 0.5
send "\x01x"
expect eof
