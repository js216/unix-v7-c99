#!/usr/bin/env expect
# SPDX-License-Identifier: MIT
# signals.expect --- exercise real kill / signal delivery / trap
# Copyright (c) 2026 Jakob Kastelic
#
# The kernel's S_KILL / S_SIGNAL / S_SIGRETURN syscalls drive the V7 sh
# trap builtin: sh's signal(N, fault) registers a handler in the
# armboot.c per-process handler table, kill -N $$ queues the signal on
# the running shell's pending mask, and the next trap-return path
# delivers it via the UENTRY_SIGTRAMP stub before user code resumes.
# trap '' N maps to SIG_IGN; trap N maps to SIG_DFL.

set kernel   $env(KERNEL)
set root_img $env(ROOT_IMG)
set log_path $env(LOG)

log_user 0
log_file -a $log_path

set timeout 60

spawn -noecho qemu-system-arm \
	-machine virt -cpu cortex-a7 -nographic -no-reboot \
	-kernel $kernel \
	-drive if=none,file=$root_img,format=raw,id=hd0 \
	-device virtio-blk-device,drive=hd0

expect {
	timeout { exit 1 }
	"login:"
}
send "root\r"

expect {
	timeout { exit 1 }
	"# "
}
send "trap 'echo HUPGOT' 1\r"
expect "# "
send "kill -1 \$\$\r"
expect "# "
send "echo HUPSEQOK\r"
expect "# "
send "kill -2 \$\$\r"
expect "# "
send "echo INTSEQOK\r"
expect "# "
send "trap '' 2\r"
expect "# "
send "echo SIGIGNOK\r"
expect "# "
send "trap 2\r"
expect "# "
send "echo TRAPRESETOK\r"
expect "# "
send "echo SIGSOK\r"
expect "# "
send "sync\r"
expect "# "
send "exit\r"
expect eof
