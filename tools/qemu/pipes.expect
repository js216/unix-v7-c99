#!/usr/bin/env expect
# SPDX-License-Identifier: MIT
# pipes.expect --- pipes, redirects, multi-stage pipelines
# Copyright (c) 2026 Jakob Kastelic

set kernel   $env(KERNEL)
set root_img $env(ROOT_IMG)
set log_path $env(LOG)

log_user 0
log_file -a $log_path

set timeout 60

spawn -noecho qemu-system-arm \
	-machine virt -cpu cortex-a7 -nographic -no-reboot \
	-kernel $kernel \
	-drive if=none,file=$root_img,format=raw,id=hd0 \
	-device virtio-blk-device,drive=hd0

expect {
	timeout { exit 1 }
	"login:"
}
send "root\r"

expect {
	timeout { exit 1 }
	"# "
}
send "echo hello | wc -c\r"
expect "# "
send "cat /etc/passwd > /tmp/p\r"
expect "# "
send "cmp /etc/passwd /tmp/p; echo CMPOK\r"
expect "# "
send "(echo one; echo two) | tail -1; echo PIPESOK\r"
expect "# "
send "sync\r"
expect "# "
send "exit\r"
# Ctrl-A x: in -nographic mode, qemu interprets the stdio escape
# sequence Ctrl-A then x as a monitor "quit" command, terminating
# qemu immediately. Without this the wrapper would block in expect
# eof until the wall-clock timeout in qemu-shell.sh fires.
sleep 0.5
send "\x01x"
expect eof
