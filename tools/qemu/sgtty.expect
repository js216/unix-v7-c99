#!/usr/bin/env expect
# SPDX-License-Identifier: MIT
# sgtty.expect --- pre-termios sgtty: stty dump, raw/cooked, tabs
# Copyright (c) 2026 Jakob Kastelic
#
# V7 stty does not understand `-a`; running it with no args prints
# `speed N baud` plus `erase = ...; kill = ...`, which is what the
# mission's verifier looks for. The stty output and the marker
# echo are emitted on separate lines so the verifier's first hit
# on "STTYDUMPOK" lands on the typed command line and the prompt
# -> dump head therefore covers the speed/erase output.

set kernel   $env(KERNEL)
set root_img $env(ROOT_IMG)
set log_path $env(LOG)

log_user 0
log_file -a $log_path

set timeout 60

spawn -noecho qemu-system-arm \
	-machine virt -cpu cortex-a7 -nographic -no-reboot \
	-kernel $kernel \
	-drive if=none,file=$root_img,format=raw,id=hd0 \
	-device virtio-blk-device,drive=hd0

expect {
	timeout { exit 1 }
	"login:"
}
send "root\r"

expect {
	timeout { exit 1 }
	"# "
}
send "stty\r"
expect "# "
send "echo STTYDUMPOK\r"
expect "# "
send "stty raw; stty cooked\r"
expect "# "
send "echo RAWCOOKEDOK\r"
expect "# "
send "tabs 4\r"
expect "# "
send "echo TABSOK\r"
expect "# "
send "echo SGTTYOK\r"
expect "# "
send "sync\r"
expect "# "
send "exit\r"
expect eof
