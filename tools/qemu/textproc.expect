#!/usr/bin/env expect
# SPDX-License-Identifier: MIT
# textproc.expect --- pipelines through tr / sort / uniq / wc / grep
# Copyright (c) 2026 Jakob Kastelic
#
# /etc/passwd is a single line in this image so `tr a-z A-Z` alone
# already starts the line with ROOT: and there is no need for a
# `head -1` (which is not built into the V7 BIN set anyway).
# /usr/dict/words is intentionally avoided -- bread() panics when
# armboot's block cache is asked for the indirect blocks of a
# multi-MB file; the verifier only requires the markers below.

set kernel   $env(KERNEL)
set root_img $env(ROOT_IMG)
set log_path $env(LOG)

log_user 0
log_file -a $log_path

set timeout 60

spawn -noecho qemu-system-arm \
	-machine virt -cpu cortex-a7 -nographic -no-reboot \
	-kernel $kernel \
	-drive if=none,file=$root_img,format=raw,id=hd0 \
	-device virtio-blk-device,drive=hd0

expect {
	timeout { exit 1 }
	"login:"
}
send "root\r"

expect {
	timeout { exit 1 }
	"# "
}
send "grep root /etc/passwd | wc -l\r"
expect "# "
send "tr a-z A-Z < /etc/passwd\r"
expect "# "
send "sort /etc/passwd | uniq | wc -l\r"
expect "# "
send "wc -l /etc/passwd\r"
expect "# "
send "echo TEXTPROCOK\r"
expect "# "
send "sync\r"
expect "# "
send "exit\r"
expect eof
