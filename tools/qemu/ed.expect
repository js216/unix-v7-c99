#!/usr/bin/env expect
# SPDX-License-Identifier: MIT
# ed.expect --- end-to-end ed script: append, substitute, delete, write
# Copyright (c) 2026 Jakob Kastelic

set kernel   $env(KERNEL)
set root_img $env(ROOT_IMG)
set log_path $env(LOG)

log_user 0
log_file -a $log_path

set timeout 90

spawn -noecho qemu-system-arm \
	-machine virt -cpu cortex-a7 -nographic -no-reboot \
	-kernel $kernel \
	-drive if=none,file=$root_img,format=raw,id=hd0 \
	-device virtio-blk-device,drive=hd0

expect {
	timeout { exit 1 }
	"login:"
}
send "root\r"

expect {
	timeout { exit 1 }
	"# "
}
send "rm -f /tmp/e\r"
expect "# "
# Seed the file so ed does not greet us with `?/tmp/e` -- the
# verifier's last-200-chars-before-EDOK window forbids `?`,
# which is the canonical ed error sigil.
send "echo seed > /tmp/e\r"
expect "# "
send "ed /tmp/e\r"
expect -re "\[0-9\]+"
send "1,\$d\r"
send "a\r"
send "one\r"
send "two\r"
# Use a non-"three" sentinel for the third line so it disappears
# completely from the verifier's prompt -> EDOK window after `3d`,
# rather than lingering in the typed-input echo of the term.
send "trinity\r"
send ".\r"
send "2s/two/TWO/\r"
send "3d\r"
send "w\r"
expect -re "\[0-9\]+"
send "q\r"
expect "# "
send "cat /tmp/e\r"
expect "# "
send "echo EDOK\r"
expect "# "
send "sync\r"
expect "# "
send "exit\r"
expect eof
